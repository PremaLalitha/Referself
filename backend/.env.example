# Backend environment variables for the Referself project
# Copy this file to backend/.env and replace values as needed.

NODE_ENV=development
PORT=5000
VITE_API_BASE=http://localhost:5000
JWT_SECRET=your_jwt_secret_key

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@referself.tunlrce.mongodb.net/?retryWrites=true&w=majority&appName=Referself

# SMTP / email settings
# For Gmail, use smtp.gmail.com and a valid app password if 2FA is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password

# Optional Google OAuth settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional OpenAI API key
OPENAI_API_KEY=your_openai_api_key
